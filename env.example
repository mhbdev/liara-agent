# Copy to .env and fill in:   cp env.example .env
# .env is gitignored.
#
# API TOKENS DO NOT GO HERE. They live encrypted in .liara/, set via:
#   sh scripts/creds.sh set staging
# That keeps them out of git and out of the AI's context entirely.

# Which environment the agents target by default. Always staging.
LIARA_ENV=staging

# Your Liara app name (see: LIARA_ENV=staging sh scripts/liara.sh app list)
LIARA_APP=my-site-staging

# Public URL the health check probes
LIARA_URL=https://my-site-staging.liara.run

# The app's own health endpoint. Strongly recommended:
# HTTP 200 on a homepage is not evidence the application works.
LIARA_HEALTH_PATH=/api/health

# ── optional tuning ──────────────────────────────────────────────────────
SLOW_MS=2000           # average latency above this reports "slow"
LIARA_TIMEOUT=180      # per-CLI-command timeout, seconds
LIARA_MAX_LINES=400    # cap on output handed to the model
APPROVAL_TTL=900       # approval lifetime, seconds (15 min)
